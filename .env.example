# Visitor counter (app/api/views). Without these the badge simply stays hidden.
#
# Vercel dashboard -> Storage -> Marketplace -> Upstash Redis. Connecting it to
# the project injects these automatically; pull them locally with `vercel env pull`.
# Server-side only: never prefix them with NEXT_PUBLIC_.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Salts the hashed visitor address used for deduplication.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VIEW_COUNTER_SALT=
